#!/usr/bin/env bash
# Run a task's verifyCommand and record that it ran.
#
#   shipshape-verify <task-id> <command> [args...]
#   shipshape-verify <task-id> "cmd one && cmd two"
#   shipshape-verify t1,t2,t3 "tests/run.sh"
#
# A single argument is run through the shell, because a verifyCommand in a plan
# fence is written as a shell line and often contains && or a pipe. Several
# arguments are executed directly, with no shell involved. Getting this wrong
# is quiet and bad: the caller's shell would split at the &&, the wrapper would
# record only the first half, and the task would read as verified by half its
# command.
#
# A comma-separated list of ids runs the command once and writes one record per
# id. Most plans verify with the whole suite, and a record goes stale when a
# task's files change, so without this the end of a branch is one full run per
# task to say the same thing each time.
#
# Transparent: output and exit code are the command's. The record at
# .shipshape/<session>/verify/<task-id> is what the plan leg reads, and it
# exists only because the command actually ran.
#
# A failing command still writes a record. Red is evidence; absence is not.

set -uo pipefail

lib="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../lib" && pwd)"
# shellcheck source=../lib/shipshape-common.sh
. "$lib/shipshape-common.sh"

# How much command output the record keeps. Enough to justify the claim,
# bounded so a chatty suite cannot fill the scratch dir.
MAX_LINES="${SHIPSHAPE_VERIFY_MAX_LINES:-200}"

if [ "$#" -lt 2 ]; then
  echo "usage: shipshape-verify <task-id> <command> [args...]" >&2
  echo "       shipshape-verify <task-id> \"cmd one && cmd two\"" >&2
  echo "       shipshape-verify t1,t2,t3 \"cmd\"" >&2
  exit 64
fi

task_id="$1"
shift

# An id becomes a filename. Sanitised through the shared helper, which is the
# same one the plan leg uses to find this record again.
safe_ids="$(shipshape_id_list "$task_id")"
[ -n "$safe_ids" ] || safe_ids="$(shipshape_safe_id "$task_id")"
label="$(printf '%s' "$safe_ids" | tr '\n' ',')"

if [ "$#" -eq 1 ]; then
  recorded="$1"
  out="$(sh -c "$1" 2>&1)"
else
  recorded="$*"
  out="$("$@" 2>&1)"
fi
status=$?

# The record's header is one field per line, and this field is the only one
# holding what a plan wrote. Left multi-line, a line of the command reading
# exit=0 would read as the record's own exit.
recorded="$(printf '%s' "$recorded" | tr '\r\n' '  ')"

printf '%s\n' "$out"

if ! shipshape_enabled VERIFY; then
  shipshape_trace verify "kill switch set; $label ran but nothing recorded"
  exit "$status"
fi

scratch="$(shipshape_scratch_dir)"
mkdir -p "$scratch/verify" 2>/dev/null

line_count="$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
truncated=""
if [ "$line_count" -gt "$MAX_LINES" ]; then
  truncated="(output truncated to the last $MAX_LINES of $line_count lines)"
  shipshape_trace verify "$label output truncated at $MAX_LINES lines"
fi

timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
epoch="$(date -u +%s)"
for safe_id in $safe_ids; do
  {
    printf 'task=%s\n' "$safe_id"
    printf 'command=%s\n' "$recorded"
    printf 'exit=%s\n' "$status"
    printf 'timestamp=%s\n' "$timestamp"
    printf 'epoch=%s\n' "$epoch"
    printf -- '--- output ---\n'
    [ -n "$truncated" ] && printf '%s\n' "$truncated"
    printf '%s\n' "$out" | tail -n "$MAX_LINES"
  } > "$scratch/verify/$safe_id"
done

shipshape_trace verify "$label exited $status"
exit "$status"
