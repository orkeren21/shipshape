#!/usr/bin/env bash
# Run one step of the scoped smoke and append it to the smoke log.
#
#   shipshape-smoke <command> [args...]
#
# The scoped smoke is the developer reflex of "did my change actually work":
# start the thing, exercise the flows the branch touched, look at the output.
# It is not an end-to-end suite — that has its own cadence and is never invoked
# per pull request.
#
# The log accumulates, because a smoke is several commands rather than one — but
# only within one commit. It records the HEAD it was gathered against, and
# resets when HEAD moves, so every entry in it always describes the code being
# shipped. Without that, appending one trivial command re-dates a log gathered
# five commits ago and the staleness check means nothing.

set -uo pipefail

lib="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../lib" && pwd)"
# shellcheck source=../lib/shipshape-common.sh
. "$lib/shipshape-common.sh"

MAX_LINES="${SHIPSHAPE_SMOKE_MAX_LINES:-200}"

if [ "$#" -lt 1 ]; then
  echo "usage: shipshape-smoke <command> [args...]" >&2
  exit 64
fi

out="$("$@" 2>&1)"
status=$?

printf '%s\n' "$out"

if ! shipshape_enabled SMOKE; then
  shipshape_trace smoke "kill switch set; command ran but nothing logged"
  exit "$status"
fi

scratch="$(shipshape_scratch_dir)"
log="$scratch/smoke.log"

# A smoke gathered against a different commit describes different code.
head_sha="$(git rev-parse HEAD 2>/dev/null)"
if [ -n "$head_sha" ]; then
  logged_head="$(grep '^head=' "$log" 2>/dev/null | head -1 | cut -d= -f2-)"
  if [ "$logged_head" != "$head_sha" ]; then
    [ -n "$logged_head" ] && shipshape_trace smoke \
      "HEAD moved since the last smoke; starting a fresh log"
    printf 'head=%s\n\n' "$head_sha" > "$log"
  fi
fi

line_count="$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
truncated=""
if [ "$line_count" -gt "$MAX_LINES" ]; then
  truncated="(output truncated to the last $MAX_LINES of $line_count lines)"
  shipshape_trace smoke "output truncated at $MAX_LINES lines"
fi

{
  printf '=== %s $ %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"
  [ -n "$truncated" ] && printf '%s\n' "$truncated"
  printf '%s\n' "$out" | tail -n "$MAX_LINES"
  printf '=== exit %s\n\n' "$status"
} >> "$log"

shipshape_trace smoke "exited $status: $*"
exit "$status"
