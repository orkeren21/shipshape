#!/usr/bin/env bash
# Open the pull request, and arm the done gate as a side effect.
#
#   shipshape-pr-open [any gh pr create arguments]
#
# Transparent: the arguments, the output and the exit code are gh's. The only
# addition is .shipshape/<session>/pr-armed, written when a PR was created, or
# may have been: --web leaves that to the browser.
#
# That file is what makes the done gate un-evadable by phrasing. The gate does
# not look for the words "I opened a PR"; it looks for the artifact that
# opening one leaves behind. No PR, no arming, nothing to satisfy. A PR, and
# the session owes a review report, green CI, a smoke log and, when a plan is
# bound, a passing record for each task, regardless of how it describes its own
# state.
#
# Arming has no off switch, and that is deliberate. The other wrappers have one
# because switching them off makes the done gate *block* — the artifact it
# wants is simply absent and it says so. Switching off arming does the reverse:
# it removes the gate for that branch entirely, silently, which is the exact
# failure mode this fork was built to close. Kill switches belong on hooks, and
# the hook that keeps bare `gh pr create` from going around this wrapper has
# one.

set -uo pipefail

lib="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../lib" && pwd)"
# shellcheck source=../lib/shipshape-common.sh
. "$lib/shipshape-common.sh"

if ! command -v gh >/dev/null 2>&1; then
  echo "shipshape-pr-open: gh is not on PATH" >&2
  shipshape_trace pr-open "gh not found; nothing armed"
  exit 127
fi

# The branch the PR is opened from. gh takes it from --head (or -H) when one is
# given, and from the current branch otherwise. The record names that branch,
# because the gates judge a record against its branch's tip: recording the
# caller's branch for a --head PR had them judge the PR against another branch
# (EnvPlode PR 92, 2026-11-17). An owner: prefix names a fork, and the branch
# is what follows it. Read before gh runs, from the arguments only.
# The value of any other flag that takes one is skipped, so a title or body
# that reads "--head" is not taken for the flag. Short flags cluster as pflag
# reads them: -dH x and -dHx name x, as -H=x does. The flags are the ones
# `gh help pr create` lists in gh 2.96.0: boolean -d, -e, -f and -w, and -a, -B,
# -b, -F, -H, -l, -m, -p, -R, -r, -T and -t with a value; --recover has no
# short form.
head_branch=""
want_head=""
skip_value=""
read_short() { # <cluster without its dash>
  local rest="$1" c
  while [ -n "$rest" ]; do
    c="${rest%"${rest#?}"}"
    rest="${rest#?}"
    case "$c" in
      d|e|f|w) : ;;
      H)
        rest="${rest#=}"
        if [ -n "$rest" ]; then head_branch="$rest"; else want_head=yes; fi
        return
        ;;
      a|B|b|F|l|m|p|R|r|T|t)
        [ -n "$rest" ] || skip_value=yes
        return
        ;;
      *) return ;;
    esac
  done
}
for arg in "$@"; do
  if [ -n "$want_head" ]; then
    head_branch="$arg"
    want_head=""
    continue
  fi
  if [ -n "$skip_value" ]; then
    skip_value=""
    continue
  fi
  case "$arg" in
    --) break ;;
    --head) want_head=yes ;;
    --head=*) head_branch="${arg#--head=}" ;;
    --assignee|--base|--body|--body-file|--label|--milestone|--project|--recover|--repo|--reviewer|--template|--title)
      skip_value=yes ;;
    --*) : ;;
    -?*) read_short "${arg#-}" ;;
  esac
done
head_branch="${head_branch#*:}"

out="$(gh pr create "$@" 2>&1)"
status=$?

printf '%s\n' "$out"

pull_url="$(printf '%s\n' "$out" | grep -o 'https://[^[:space:]]*/pull/[0-9][0-9]*' | tail -1)"

# What gh printed decides, never the arguments: a body of "-h" still opens a PR.
#
# gh can make the PR and then fail on what comes after, such as a reviewer. It
# prints the URL, and a retry says the PR exists and exits 1, so this is the one
# chance to arm. Any other failure opened nothing, even one that names a PR.
if [ "$status" -ne 0 ]; then
  if [ -z "$pull_url" ] || ! grep -q 'pull request update failed' <<<"$out"; then
    shipshape_trace pr-open "gh pr create exited $status; nothing armed"
    exit "$status"
  fi
fi

# Its help and a dry run exit 0 too and open nothing, and either can carry a URL.
# Real creation prints neither line. If gh rewords them the run arms, which is
# the safe way round. A here-string, not a pipe: with pipefail, grep -q leaving
# early kills a long printf, and the pipeline reads as no match.
if grep -qE '^(Would have created a Pull Request with:|  gh pr create \[flags\])$' <<<"$out"; then
  shipshape_trace pr-open "gh opened no pull request; nothing armed"
  exit "$status"
fi

url="${pull_url:-$(printf '%s\n' "$out" | grep -o 'https://[^[:space:]]*' | tail -1)}"

scratch="$(shipshape_scratch_dir)"

# Where the record is filed. A PR is judged in the worktree that has its branch
# checked out, so a --head branch checked out in another worktree gets its
# record in the session's folder there, where its CI and smoke will be. One
# checked out nowhere is filed here, and cannot be judged until it is checked
# out somewhere: stderr says so, because stdout is gh's.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ -n "$head_branch" ]; then
  branch="$head_branch"
  if [ "$head_branch" != "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" ]; then
    if ! head_checkout="$(shipshape_branch_checkout "$head_branch")"; then
      shipshape_trace pr-open "git cannot list worktrees; the record for $head_branch is filed here"
    elif [ -z "$head_checkout" ]; then
      echo "shipshape-pr-open: $head_branch is not checked out in any worktree, so this PR's evidence cannot be judged until it is. Check it out (git worktree add <path> $head_branch), then run its wrappers there." >&2
      shipshape_trace pr-open "$head_branch is checked out nowhere; the record is filed here, and judged only once it is checked out"
    elif [ -z "${SHIPSHAPE_SCRATCH_ROOT:-}" ] && [ "$(shipshape_session_id)" != "unknown" ] &&
      ! shipshape_same_place "$head_checkout" "$(shipshape_scratch_root)"; then
      head_scratch="$head_checkout/.shipshape/$(shipshape_session_id)"
      if mkdir -p "$head_scratch" 2>/dev/null; then
        scratch="$head_scratch"
        echo "shipshape-pr-open: $head_branch is checked out in $head_checkout, so the record is filed there; run this PR's wrappers there (cd $head_checkout && shipshape-ci-watch, shipshape-smoke)." >&2
      else
        shipshape_trace pr-open "cannot create $head_scratch; the record for $head_branch is filed here"
      fi
    fi
  fi
fi

# The obligation is tracked per PR, keyed by its number, so a later PR in the
# same session arms its own record instead of overwriting this one's — the
# cascade where PR #2's arming evaporated PR #1's unmet evidence was a field
# failure, not a hypothetical. A URL the number cannot be parsed from still
# gets a record: an unnumbered obligation beats an evaporated one.
number="$(printf '%s' "$url" | sed -n 's#.*/pull/\([0-9][0-9]*\).*#\1#p')"
[ -n "$number" ] || number="unknown-$(date -u +%s)"
record="pr-armed-$(shipshape_safe_id "$number" "unknown")"

# The branch is recorded so the gate can tell that this session has moved on
# to different work. Without it, a session that ships one branch and starts
# another stays armed against the first branch's evidence forever.
#
# The un-numbered pr-armed is still written for the current PR: gates one
# version behind read only that name, and it must never be the reason a gate
# stays dark.
{
  printf 'url=%s\n' "$url"
  printf 'number=%s\n' "$number"
  printf 'branch=%s\n' "$branch"
  printf 'timestamp=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'epoch=%s\n' "$(date -u +%s)"
} > "$scratch/$record"
cp "$scratch/$record" "$scratch/pr-armed" 2>/dev/null

shipshape_trace pr-open "armed done gate for $url ($record, branch $branch, in $scratch)"

# The last moment a forgotten binding can be noticed, since with no plan bound the
# leg reads none, and none settles. A clearing is named too, and never instead: it
# may be another branch's. On stderr, because stdout is gh's.
plan_cleared="$(shipshape_plan_cleared "$scratch")"
if [ -n "$plan_cleared" ]; then
  echo "shipshape-pr-open: a plan was cleared this session: $plan_cleared" >&2
fi
if [ -z "$(shipshape_plan_field "$scratch" path)" ]; then
  echo "shipshape-pr-open: no plan is bound, so nothing holds this branch to one. If it has a plan: shipshape-plan \"<path>\"" >&2
fi
exit "$status"
