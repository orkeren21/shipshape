#!/usr/bin/env bash
# Open the pull request, and arm the done gate as a side effect.
#
#   shipshape-pr-open [any gh pr create arguments]
#
# Transparent: the arguments, the output and the exit code are gh's. The only
# addition is .shipshape/<session>/pr-armed, written when — and only when — a
# PR was actually created.
#
# That file is what makes the done gate un-evadable by phrasing. The gate does
# not look for the words "I opened a PR"; it looks for the artifact that
# opening one leaves behind. No PR, no arming, nothing to satisfy. A PR, and
# the session owes a review report, green CI, a smoke log and, when a plan is
# bound, a passing record for each task, regardless of how it describes its own
# state.
#
# Arming has no off switch, and that is deliberate. The other wrappers have one
# because switching them off makes the done gate *block* — the artifact it
# wants is simply absent and it says so. Switching off arming does the reverse:
# it removes the gate for that branch entirely, silently, which is the exact
# failure mode this fork was built to close. Kill switches belong on hooks, and
# the hook that keeps bare `gh pr create` from going around this wrapper has
# one.

set -uo pipefail

lib="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../lib" && pwd)"
# shellcheck source=../lib/shipshape-common.sh
. "$lib/shipshape-common.sh"

if ! command -v gh >/dev/null 2>&1; then
  echo "shipshape-pr-open: gh is not on PATH" >&2
  shipshape_trace pr-open "gh not found; nothing armed"
  exit 127
fi

out="$(gh pr create "$@" 2>&1)"
status=$?

printf '%s\n' "$out"

if [ "$status" -ne 0 ]; then
  shipshape_trace pr-open "gh pr create exited $status; nothing armed"
  exit "$status"
fi

# gh prints the PR URL on success. Its help and a dry run exit 0 too, and help
# carries a URL, so those two open nothing and arm nothing. The flag alone can't
# decide, or a body of "-h" would open a PR and leave no record: a pull URL in the
# output always arms.
pull_url="$(printf '%s\n' "$out" | grep -o 'https://[^[:space:]]*/pull/[0-9][0-9]*' | tail -1)"
if [ -z "$pull_url" ]; then
  for arg in "$@"; do
    case "$arg" in
      --help|-h|--dry-run)
        shipshape_trace pr-open "$arg opened no pull request; nothing armed"
        exit 0
        ;;
    esac
  done
fi
url="${pull_url:-$(printf '%s\n' "$out" | grep -o 'https://[^[:space:]]*' | tail -1)}"

scratch="$(shipshape_scratch_dir)"

# The obligation is tracked per PR, keyed by its number, so a later PR in the
# same session arms its own record instead of overwriting this one's — the
# cascade where PR #2's arming evaporated PR #1's unmet evidence was a field
# failure, not a hypothetical. A URL the number cannot be parsed from still
# gets a record: an unnumbered obligation beats an evaporated one.
number="$(printf '%s' "$url" | sed -n 's#.*/pull/\([0-9][0-9]*\).*#\1#p')"
[ -n "$number" ] || number="unknown-$(date -u +%s)"
record="pr-armed-$(shipshape_safe_id "$number" "unknown")"

# The branch is recorded so the gate can tell that this session has moved on
# to different work. Without it, a session that ships one branch and starts
# another stays armed against the first branch's evidence forever.
#
# The un-numbered pr-armed is still written for the current PR: gates one
# version behind read only that name, and it must never be the reason a gate
# stays dark.
{
  printf 'url=%s\n' "$url"
  printf 'number=%s\n' "$number"
  printf 'branch=%s\n' "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
  printf 'timestamp=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'epoch=%s\n' "$(date -u +%s)"
} > "$scratch/$record"
cp "$scratch/$record" "$scratch/pr-armed" 2>/dev/null

shipshape_trace pr-open "armed done gate for $url ($record)"

# The last moment a forgotten binding can be noticed, since with no plan bound the
# leg reads none, and none settles. A clearing is named too, and never instead: it
# may be another branch's. On stderr, because stdout is gh's.
plan_cleared="$(shipshape_plan_cleared "$scratch")"
if [ -n "$plan_cleared" ]; then
  echo "shipshape-pr-open: a plan was cleared this session: $plan_cleared" >&2
fi
if [ -z "$(shipshape_plan_field "$scratch" path)" ]; then
  echo "shipshape-pr-open: no plan is bound, so nothing holds this branch to one. If it has a plan: shipshape-plan \"<path>\"" >&2
fi
exit 0
