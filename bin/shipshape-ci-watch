#!/usr/bin/env bash
# Watch CI to a verdict, and record what the verdict was.
#
#   shipshape-ci-watch [pr-number-or-url] [extra gh pr checks arguments]
#
# Two questions, because they are not the same question:
#
#   1. Did the checks that ran pass?          gh pr checks --watch
#   2. Is the pull request actually mergeable? gh pr view --json mergeStateStatus
#
# The second is the bar. A recorded incident had every check green and four
# more required checks never scheduled — "everything I could see passed" read
# as done, and it was not. GitHub's merge state already accounts for required
# checks that have not run, so it is the honest answer to "is this shippable".
#
# Red is written down, never left as an absent file: a gate cannot tell "CI
# failed" from "nobody ran CI" if failure means no artifact.

set -uo pipefail

lib="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../lib" && pwd)"
# shellcheck source=../lib/shipshape-common.sh
. "$lib/shipshape-common.sh"

# GitHub reports UNKNOWN while it works out mergeability. Look again a few
# times, with the bound written down and the cap logged when it is reached.
MERGE_STATE_ATTEMPTS="${SHIPSHAPE_MERGE_STATE_ATTEMPTS:-3}"
MERGE_STATE_DELAY="${SHIPSHAPE_MERGE_STATE_RETRY_DELAY:-5}"

record() { # record <result> <checks_exit> <merge_state> <checks_output> [review_decision]
  shipshape_enabled CI_WATCH || return 0
  local scratch
  scratch="$(shipshape_scratch_dir)"
  {
    printf 'result=%s\n' "$1"
    printf 'checks_exit=%s\n' "$2"
    printf 'merge_state=%s\n' "$3"
    printf 'review_decision=%s\n' "${5:-}"
    printf 'timestamp=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'epoch=%s\n' "$(date -u +%s)"
    printf -- '--- checks ---\n'
    printf '%s\n' "$4"
  } > "$scratch/ci-status"
}

if ! command -v gh >/dev/null 2>&1; then
  echo "shipshape-ci-watch: gh is not on PATH" >&2
  shipshape_trace ci-watch "gh not found"
  record unknown 127 UNAVAILABLE "gh is not on PATH"
  exit 127
fi

pr=""
case "${1:-}" in
  ''|-*) : ;;
  *) pr="$1"; shift ;;
esac

if [ -n "$pr" ]; then
  checks_out="$(gh pr checks "$pr" --watch "$@" 2>&1)"
else
  checks_out="$(gh pr checks --watch "$@" 2>&1)"
fi
checks_exit=$?

printf '%s\n' "$checks_out"

# The merge bar, looked at until it settles or the cap is reached.
merge_state="UNKNOWN"
attempt=1
while [ "$attempt" -le "$MERGE_STATE_ATTEMPTS" ]; do
  if [ -n "$pr" ]; then
    view_out="$(gh pr view "$pr" --json mergeStateStatus,reviewDecision,statusCheckRollup,url 2>/dev/null)"
  else
    view_out="$(gh pr view --json mergeStateStatus,reviewDecision,statusCheckRollup,url 2>/dev/null)"
  fi
  view_exit=$?

  if [ "$view_exit" -ne 0 ]; then
    merge_state="UNREADABLE"
    shipshape_trace ci-watch "gh pr view exited $view_exit; merge bar unreadable"
    break
  fi

  merge_state="$(shipshape_json_get "$view_out" mergeStateStatus)"
  review_decision="$(shipshape_json_get "$view_out" reviewDecision)"
  [ -n "$merge_state" ] || merge_state="UNKNOWN"
  [ "$merge_state" = "UNKNOWN" ] || break

  if [ "$attempt" -lt "$MERGE_STATE_ATTEMPTS" ]; then
    [ "$MERGE_STATE_DELAY" -gt 0 ] 2>/dev/null && sleep "$MERGE_STATE_DELAY"
  fi
  attempt=$((attempt + 1))
done

if [ "$merge_state" = "UNKNOWN" ]; then
  shipshape_trace ci-watch \
    "merge state still UNKNOWN after $MERGE_STATE_ATTEMPTS looks — retry cap reached"
fi

# CLEAN and HAS_HOOKS are the mergeable states. BLOCKED means a required check
# is missing or failing; BEHIND means the branch is out of date; DIRTY means
# conflicts. None of those are green, and each is recorded by name so the
# session is told what to fix rather than just that something is wrong.
result=red
case "$checks_exit:$merge_state" in
  0:CLEAN|0:HAS_HOOKS) result=green ;;
  # BLOCKED covers two very different situations. A required check that failed
  # or never ran is CI's problem and the session's to fix. A pull request
  # waiting on a human approval is neither — telling the session to "diagnose
  # and fix CI" would send it after a problem CI cannot solve, and refusing to
  # let the branch finish would make the gate unsatisfiable on any repository
  # that requires review. Recorded distinctly, and treated as passing.
  0:BLOCKED)
    # reviewDecision says nothing about checks. A required check that was never
    # scheduled also reports BLOCKED, and `gh pr checks` exits 0 because it only
    # sees the checks that exist — which is exactly the incident in the header
    # comment. So the downgrade needs the rollup to be clear as well.
    if [ "${review_decision:-}" = "REVIEW_REQUIRED" ] \
       && ! printf '%s' "$view_out" | grep -qE '"(state|conclusion|status)":"(PENDING|EXPECTED|QUEUED|IN_PROGRESS|FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED)"'; then
      result=green-pending-review
    fi
    ;;
esac

record "$result" "$checks_exit" "$merge_state" "$checks_out" "${review_decision:-}"

if [ "$result" = green-pending-review ]; then
  shipshape_trace ci-watch "checks green; merge bar waiting on a human approval"
  echo "shipshape-ci-watch: checks are green; the pull request is waiting on an approving review." >&2
  exit 0
fi

if [ "$result" = green ]; then
  shipshape_trace ci-watch "green (merge state $merge_state)"
  exit 0
fi

echo "shipshape-ci-watch: not mergeable — checks exited $checks_exit, merge state $merge_state" >&2
shipshape_trace ci-watch "not green: checks_exit=$checks_exit merge_state=$merge_state"
[ "$checks_exit" -ne 0 ] && exit "$checks_exit"
exit 1
