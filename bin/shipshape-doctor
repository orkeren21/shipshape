#!/usr/bin/env bash
# Print the evidence state the gates would act on. Read-only, exit 0, always.
#
#   shipshape-doctor          the report, for a person
#   shipshape-doctor --json   the same state, for a program (format 1)
#
# Diagnosis and enforcement stay separate on purpose. The done gate nudges and
# the merge gate refuses; this only answers "where am I" — which PRs this
# session armed, what each leg of the evidence looks like against the current
# HEAD, which waivers are active, and what the merge gate would say right now.
# It writes nothing, not even a trace: a diagnostic that mutates state can be
# gamed into a bypass, and one that exits non-zero becomes a gate nobody
# asked for.
#
# The verdict logic mirrors the gates by reading the same artifacts the same
# way. If the doctor and a gate ever disagree, the doctor is wrong and the
# gate is the truth — tests pin them together.
#
# --json is what the companion mod draws its band from, so the evidence logic
# keeps one copy, here. Both forms render one evaluation: the legs and records
# are read once, then printed as sentences or as JSON. A leg's state is the
# evaluator's own word (ok, missing, stale, ...), or waived.

set -uo pipefail

lib="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../lib" && pwd)"
# shellcheck source=../lib/shipshape-common.sh
. "$lib/shipshape-common.sh"

json_mode=""
case "${1:-}" in
  --json) json_mode="yes" ;;
  '') : ;;
  *) echo "shipshape-doctor: unknown argument '$1' (usage: shipshape-doctor [--json])" >&2 ;;
esac

# The scratch path is computed, never created — shipshape_scratch_dir would
# mkdir, and looking must not leave footprints.
scratch="$(shipshape_scratch_path)"

current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
current_head="$(git rev-parse HEAD 2>/dev/null)"

field() { grep "^$2=" "$1" 2>/dev/null | head -1 | cut -d= -f2-; }

# ---- the evidence legs, as the done gate reads them -------------------------
#
# Verdicts come from the shared evaluators the gates read — the doctor owns
# only the phrasing. A diagnostic that applies looser rules than the gate is
# worse than none: the denial message points sessions here.

leg_eval() { # <leg> <waiver key> -> "state|detail"
  if shipshape_waived "$2"; then
    printf 'waived|%s' "$(shipshape_waiver_line "$2")"
    return 0
  fi
  "shipshape_leg_$1" "$scratch"
}

review_leg="$(leg_eval review review)"
ci_leg="$(leg_eval ci ci)"
smoke_leg="$(leg_eval smoke smoke)"
# A waiver with no plan bound has nothing to waive, and the band draws this leg
# only while a plan is bound. A clearing is not one of the leg's words: it reads
# as none, and what was dropped travels beside it.
plan_leg="none|"
[ -z "$(shipshape_plan_field "$scratch" path)" ] || plan_leg="$(leg_eval plan plan)"
plan_cleared="$(shipshape_plan_cleared "$scratch")"
merge_waived=""
shipshape_waived merge_gate && merge_waived="yes"

# ---- the obligation records, as the merge gate judges them ------------------
#
# One line per record: number, url, branch, state (owing|stale|satisfied),
# the head it was satisfied at, and the branch's head now. Fields are split on
# the ASCII unit separator: a tab is IFS whitespace, so an empty field (a
# record with no url) would collapse and shift every field after it.

sep="$(printf '\037')"

record_files=""
for record_file in "$scratch"/pr-armed-*; do
  [ -f "$record_file" ] || continue
  record_files="$record_files$record_file
"
done
if [ -z "$record_files" ] && [ -f "$scratch/pr-armed" ]; then
  record_files="$scratch/pr-armed
"
fi

records=""
while IFS= read -r record_file; do
  [ -n "$record_file" ] || continue
  case "$(basename "$record_file")" in
    pr-armed) rec_number="legacy" ;;
    *)        rec_number="$(basename "$record_file" | sed 's/^pr-armed-//')" ;;
  esac
  rec_branch="$(field "$record_file" branch)"
  rec_url="$(field "$record_file" url)"
  stamp="$scratch/pr-satisfied-$rec_number"
  stamp_head=""
  branch_head=""
  if [ ! -f "$stamp" ]; then
    rec_state="owing"
  else
    stamp_head="$(field "$stamp" head)"
    stamp_branch="$(field "$stamp" branch)"
    [ -n "$stamp_branch" ] && branch_head="$(shipshape_branch_tip "$stamp_branch")"
    if [ -n "$branch_head" ] && [ "$stamp_head" != "$branch_head" ]; then
      rec_state="stale"
    else
      rec_state="satisfied"
    fi
  fi
  records="$records$rec_number$sep$rec_url$sep$rec_branch$sep$rec_state$sep$stamp_head$sep$branch_head
"
done <<SHIPSHAPE_RECORDS
$record_files
SHIPSHAPE_RECORDS

# ---- --json ----------------------------------------------------------------

if [ -n "$json_mode" ]; then
  str() { # <value> -> a JSON string, or null when empty
    if [ -n "$1" ]; then shipshape_json_escape "$1"; else printf 'null'; fi
  }
  leg_json() { # <state|detail>
    printf '{"state":%s,"detail":%s}' "$(str "${1%%|*}")" "$(str "${1#*|}")"
  }

  role="$(shipshape_seat_field "$scratch" role)"
  if [ -n "$role" ]; then
    seat_json="$(printf '{"role":%s,"lane":%s,"epic":%s,"handoff":%s}' \
      "$(str "$role")" "$(str "$(shipshape_seat_field "$scratch" lane)")" \
      "$(str "$(shipshape_seat_field "$scratch" epic)")" \
      "$(str "$(shipshape_seat_field "$scratch" handoff)")")"
  else
    seat_json="null"
  fi

  # A background reviewer is out while review-capture's pending file exists;
  # its mtime is the launch. Only the kinds review-capture writes count.
  pending_json=""
  for pending in "$scratch"/pending-capture/*; do
    [ -f "$pending" ] || continue
    kind="$(head -1 "$pending" 2>/dev/null)"
    case "$kind" in review|conformance) : ;; *) continue ;; esac
    since="$(shipshape_mtime "$pending")" || since=""
    pending_json="$pending_json${pending_json:+,}$(printf '{"agent":%s,"kind":%s,"since":%s}' \
      "$(str "$(basename "$pending")")" "$(str "$kind")" "${since:-null}")"
  done

  prs_json=""
  while IFS="$sep" read -r n url br st _ _; do
    [ -n "$n" ] || continue
    prs_json="$prs_json${prs_json:+,}$(printf '{"number":%s,"url":%s,"branch":%s,"state":%s}' \
      "$(str "$n")" "$(str "$url")" "$(str "$br")" "$(str "$st")")"
  done <<SHIPSHAPE_PRS
$records
SHIPSHAPE_PRS

  printf '{"format":1,"session":%s,"branch":%s,"head":%s,"scratch":%s,"seat":%s,' \
    "$(str "$(shipshape_session_id)")" "$(str "$current_branch")" \
    "$(str "$current_head")" "$(str "$scratch")" "$seat_json"
  printf '"legs":{"review":%s,"ci":%s,"smoke":%s,"plan":%s},' \
    "$(leg_json "$review_leg")" "$(leg_json "$ci_leg")" "$(leg_json "$smoke_leg")" \
    "$(leg_json "$plan_leg")"
  printf '"pending":[%s],"merge_gate_waived":%s,"plan_cleared":%s,"prs":[%s]}\n' \
    "$pending_json" "$([ -n "$merge_waived" ] && echo true || echo false)" \
    "$(str "$plan_cleared")" "$prs_json"
  exit 0
fi

# ---- the report --------------------------------------------------------------

printf 'ShipShape doctor — session %s, branch %s (HEAD %s)\n\n' \
  "$(shipshape_session_id)" "${current_branch:-none}" \
  "$(printf '%s' "${current_head:-no-git}" | cut -c1-8)"

# A split session's other folder explains a leg that reads missing below.
other_dirs="$(shipshape_other_scratch_dirs "$scratch")"
if [ -n "$other_dirs" ]; then
  printf 'note — this session also has scratch in another checkout, which the gates do not read:\n'
  other_review=""
  while IFS= read -r other; do
    [ -n "$other" ] || continue
    held="$(ls -A "$other" 2>/dev/null | paste -sd, - | sed 's/,/, /g')"
    printf '  %s\n    holds: %s\n' "$other" "${held:-(empty)}"
    for report in "$other"/review-*.md; do
      [ -f "$report" ] && other_review="yes" && break
    done
  done <<SHIPSHAPE_OTHERS
$other_dirs
SHIPSHAPE_OTHERS
  printf '  The usual causes: older ShipShape hooks, which ran from the main checkout\n'
  printf '  in a desktop-app worktree session, or a subagent working in a worktree of\n'
  printf '  its own. Nothing there counts here: a leg that reads missing or open below is\n'
  printf '  produced again, in this checkout.\n'
  [ -n "$other_review" ] &&
    printf '  For the review, re-dispatch the whole-branch review rather than copying\n  its report.\n'
  printf '\n'
fi

leg_line() { printf '  %-8s %s\n' "$1" "$2"; }

detail="${review_leg#*|}"
case "${review_leg%%|*}" in
  waived)     leg_line review "waived — $detail" ;;
  missing)    leg_line review 'missing — dispatch the reviewer with "whole-branch-review:" in the description' ;;
  empty)      leg_line review "ignored (empty): $detail — an empty file is not a review; dispatch the reviewer" ;;
  stale)      leg_line review "stale — $detail predates HEAD (a background review counts from its launch); re-review the branch, and past its fourth review, escalate first (shipshape:requesting-code-review, step 4)" ;;
  no-verdict) leg_line review "no verdict — $detail never answers \"Ready to merge?\" with Yes, No or With fixes" ;;
  verdict-no) leg_line review "verdict is no — fix what $detail found and re-review, and past the branch's fourth review, escalate first (shipshape:requesting-code-review, step 4)" ;;
  ok)         leg_line review "ok — $detail, fresh, verdict yes" ;;
esac

detail="${ci_leg#*|}"
case "${ci_leg%%|*}" in
  waived)    leg_line ci "waived — $detail" ;;
  missing)   leg_line ci "missing — run shipshape-ci-watch" ;;
  not-green) leg_line ci "not green (merge state ${detail:-unknown}) — fix and run shipshape-ci-watch again" ;;
  stale)     leg_line ci "stale — predates HEAD; run shipshape-ci-watch again" ;;
  ok)        leg_line ci "green and fresh" ;;
esac

detail="${smoke_leg#*|}"
case "${smoke_leg%%|*}" in
  waived)   leg_line smoke "waived — $detail" ;;
  missing)  leg_line smoke "missing — exercise the changed flows through shipshape-smoke" ;;
  stale)    leg_line smoke "stale — gathered against $(printf '%s' "$detail" | cut -c1-8); smoke the branch again" ;;
  no-runs)  leg_line smoke "no completed run — exercise the changed flows through shipshape-smoke" ;;
  failures) leg_line smoke "${detail%%/*} of ${detail#*/} commands failed — a failing smoke is not evidence" ;;
  ok)       leg_line smoke "ok — all commands exit 0, current HEAD" ;;
esac

detail="${plan_leg#*|}"
case "${plan_leg%%|*}" in
  waived)        leg_line plan "waived — $detail" ;;
  none)          leg_line plan "${detail:-no plan bound}${plan_cleared:+; cleared: $plan_cleared}" ;;
  ok)            leg_line plan "ok — every task in scope closed" ;;
  open)          leg_line plan "open — $detail has no current record" ;;
  stale)         leg_line plan "stale — a file of $detail changed after its record" ;;
  failed)        leg_line plan "failed — $detail exited non-zero" ;;
  wrong-command) leg_line plan "wrong command — $detail ran something other than the fence's command; quote it whole" ;;
  elsewhere)     leg_line plan "elsewhere — $detail; bind it here, or shipshape-plan --clear --reason <why>"
                 printf '           %s\n' "$(shipshape_plan_rebind "$scratch")" ;;
  unreadable)    leg_line plan "unreadable — $detail; fix it and bind again, or waive it in .shipshape.yaml: skip_plan: true  # reason: <why>" ;;
esac

# One line per task the leg is not happy with, then what closes them, then what
# the scope left out. Those print whatever the leg says, because the reason is
# the part a reviewer reads, and a waived or misplaced plan does not change it.
plan_task() { printf '           %-14s %s%s\n' "$1" "$2" "${3:+ — $3}"; }
case "${plan_leg%%|*}" in
  none) : ;;
  *)
    plan_rows="$(shipshape_plan_rows "$scratch")"
    case "${plan_leg%%|*}" in
      waived|elsewhere) : ;;
      *)
        printf '%s\n' "$plan_rows" | while IFS="$sep" read -r task task_state _ note; do
          case "$task_state" in ok|closed|left-out|'') continue ;; esac
          plan_task "$task" "$task_state" "$note"
        done
        shipshape_plan_rerun "$scratch" | sed 's/^/           /'
        ;;
    esac
    printf '%s\n' "$plan_rows" | while IFS="$sep" read -r task task_state _ note; do
      [ "$task_state" != "left-out" ] || plan_task "$task" "$task_state" "$note"
    done
    [ -z "$plan_cleared" ] || printf '           cleared: %s\n' "$plan_cleared"
    ;;
esac

if [ -n "$merge_waived" ]; then
  leg_line merge "gate waived — $(shipshape_waiver_line merge_gate)"
fi

printf '\n'

if [ -z "$records" ]; then
  printf 'nothing armed this session — no pull request opened through shipshape-pr-open.\n'
  exit 0
fi

while IFS="$sep" read -r n url br st stamp_head branch_head; do
  [ -n "$n" ] || continue
  case "$st" in
    owing)
      printf 'PR #%s (%s, branch %s) — OWING\n' "$n" "${url:-url unrecorded}" "${br:-unknown}"
      printf '  merge gate: would deny (merge_gate_unsatisfied)\n'
      ;;
    stale)
      printf 'PR #%s (%s, branch %s) — STALE: satisfied at %s, branch now at %s\n' \
        "$n" "${url:-url unrecorded}" "${br:-unknown}" \
        "$(printf '%s' "$stamp_head" | cut -c1-8)" "$(printf '%s' "$branch_head" | cut -c1-8)"
      printf '  merge gate: would deny (merge_gate_stale)\n'
      ;;
    satisfied)
      printf 'PR #%s (%s, branch %s) — SATISFIED at %s\n' \
        "$n" "${url:-url unrecorded}" "${br:-unknown}" \
        "$(printf '%s' "$stamp_head" | cut -c1-8)"
      [ -n "$branch_head" ] || printf '  no tip here or on origin, so its freshness is not judged\n'
      printf '  merge gate: would allow the merge\n'
      ;;
  esac
done <<SHIPSHAPE_RECORDS
$records
SHIPSHAPE_RECORDS

exit 0
